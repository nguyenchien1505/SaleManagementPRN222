@model WebBanHang.ViewModels.DeleteProductVM

@{
    ViewData["Title"] = "Xóa vĩnh viễn sản phẩm";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Xóa vĩnh viễn sản phẩm
            </h4>
        </div>

        <div class="card-body">
            <div class="alert alert-danger">
                <strong>Cảnh báo:</strong>
                Thao tác này không thể hoàn tác. Sản phẩm sẽ bị xóa hoàn toàn khỏi hệ thống.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Mã sản phẩm</dt>
                <dd class="col-sm-9">@Model.Code</dd>

                <dt class="col-sm-3">Tên sản phẩm</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Danh mục</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Giá bán</dt>
                <dd class="col-sm-9">
                    @Model.SellingPrice.ToString("N0") VNĐ
                </dd>

                <dt class="col-sm-3">Tồn kho</dt>
                <dd class="col-sm-9">@Model.StockQuantity</dd>
            </dl>

            <form asp-area="Admin" asp-controller="Product" asp-action="HardDelete" method="post">

                <input type="hidden" asp-for="ProductId" />

                <button type="submit" class="btn btn-danger"> <i class="fas fa-trash-alt me-2"></i>
                    Xác nhận xóa vĩnh viễn
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    Hủy
                </a>
            </form>
        </div>
    </div>
</div>