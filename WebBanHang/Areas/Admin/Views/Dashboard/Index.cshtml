@using System.Text.Json
@using WebBanHang.BLL.DTOs
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "_AdminLayout";

    var overview = ViewBag.Overview as DashboardOverviewDTO ?? new DashboardOverviewDTO();
    var revenueStats = ViewBag.RevenueStats as List<RevenueStatDTO> ?? new List<RevenueStatDTO>();
    var chartData = ViewBag.ChartData as DashboardChartDTO ?? new DashboardChartDTO();
    var recentOrders = ViewBag.RecentOrders as List<WebBanHang.DAL.Entities.Order>;

    var jsonOptions = new JsonSerializerOptions();
}

<style>
    .stats-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        height: 100%;
    }

        .stats-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08);
        }

    .card-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .trend-badge {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
    }

    .product-img-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .top-product-item {
        padding: 12px;
        border-radius: 12px;
        transition: background 0.2s;
        border: 1px solid transparent;
    }

        .top-product-item:hover {
            background: #f8faff;
            border-color: #eef2ff;
        }

    .period-btn.active {
        background-color: #0d6efd;
        color: #fff;
    }
</style>

<!-- ============================ -->
<!-- 1. OVERVIEW: 4 thẻ KPI -->
<!-- ============================ -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stats-card shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="card-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <h6 class="text-muted fw-medium mb-1">Tổng sản phẩm</h6>
            <h3 class="fw-bold mb-0 text-dark">@overview.TotalProducts <small class="fw-normal text-muted" style="font-size: 0.9rem;">SP</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stats-card shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="card-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
            <h6 class="text-muted fw-medium mb-1">Tổng đơn hàng</h6>
            <h3 class="fw-bold mb-0 text-dark">@overview.TotalOrders <small class="fw-normal text-muted" style="font-size: 0.9rem;">đơn</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stats-card shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="card-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <h6 class="text-muted fw-medium mb-1">Tổng doanh thu</h6>
            <h3 class="fw-bold mb-0 text-dark">@overview.TotalRevenue.ToString("N0") <small class="fw-normal text-muted" style="font-size: 0.9rem;">xu</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stats-card shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="card-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <h6 class="text-muted fw-medium mb-1">Tổng khách hàng</h6>
            <h3 class="fw-bold mb-0 text-dark">@overview.TotalCustomers <small class="fw-normal text-muted" style="font-size: 0.9rem;">KH</small></h3>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- 2. Thống kê đơn hàng theo trạng thái -->
<!-- ============================================= -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart me-2 text-primary"></i>Đơn hàng theo trạng thái</h5>
            </div>
            <div class="card-body px-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span><span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Draft (chờ xác nhận)</span></span>
                    <span class="fw-bold">@overview.DraftOrders</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span><span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Confirmed (đã xác nhận)</span></span>
                    <span class="fw-bold">@overview.ConfirmedOrders</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Completed (hoàn thành)</span></span>
                    <span class="fw-bold">@overview.CompletedOrders</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Cancelled (đã hủy)</span></span>
                    <span class="fw-bold">@overview.CancelledOrders</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê doanh thu theo Ngày / Tháng / Năm -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar3 me-2 text-primary"></i>Thống kê doanh thu</h5>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary period-btn" data-period="day">Ngày</button>
                    <button type="button" class="btn btn-outline-primary period-btn active" data-period="month">Tháng</button>
                    <button type="button" class="btn btn-outline-primary period-btn" data-period="year">Năm</button>
                </div>
            </div>
            <div class="card-body px-4" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="text-muted small text-uppercase">
                        <tr>
                            <th>Thời gian</th>
                            <th class="text-end">Số đơn</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody id="revenueStatsBody">
                        @foreach (var stat in revenueStats)
                        {
                            <tr>
                                <td>@stat.Label</td>
                                <td class="text-end">@stat.OrderCount</td>
                                <td class="text-end fw-bold">@stat.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- 3. Biểu đồ: Revenue Chart / Order Chart / Product Chart -->
<!-- ============================================= -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>Doanh thu theo tháng</h5>
            </div>
            <div class="card-body px-4">
                <canvas id="revenueChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart me-2 text-primary"></i>Số đơn theo tháng</h5>
            </div>
            <div class="card-body px-4">
                <canvas id="orderChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Orders -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Đơn hàng gần đây</h5>
                    <a asp-area="Sale" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3 fw-medium">Xem tất cả</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4 py-3">Mã Đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th class="pe-4">Ngày</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var order in recentOrders)
                                {
                                    <tr style="cursor: pointer;" onclick="window.location='@Url.Action("Details", "Orders", new { area = "Sale", id = order.OrderId })'">
                                        <td class="ps-4">
                                            <span class="badge bg-light text-dark border fw-bold">#@order.OrderId</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    @(string.IsNullOrEmpty(order.Customer?.User?.FullName) ? "?" : order.Customer.User.FullName[0].ToString().ToUpper())
                                                </div>
                                                <span class="fw-medium">@(order.Customer?.User?.FullName ?? "Khách hàng ẩn danh")</span>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark">@((order.TotalAmount ?? 0m).ToString("N0")) xu</td>
                                        <td>
                                            @{
                                                var (badgeClass, statusText) = order.Status switch
                                                {
                                                    "Completed" => ("bg-success", "Hoàn thành"),
                                                    "Confirmed" => ("bg-warning", "Đã xác nhận"),
                                                    "Cancelled" => ("bg-danger", "Đã hủy"),
                                                    "Draft" => ("bg-secondary", "Chờ xác nhận"),
                                                    _ => ("bg-secondary", order.Status ?? "Không rõ")
                                                };
                                            }
                                            <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") rounded-pill px-3">@statusText</span>
                                        </td>
                                        <td class="text-muted small pe-4">@order.OrderDate?.ToString("HH:mm dd/MM/yy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <i class="bi bi-inbox text-muted fs-1 d-block mb-3"></i>
                                        <span class="text-muted">Chưa có đơn hàng nào</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Products + Product Chart -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-fire me-2 text-danger"></i>Sản phẩm bán chạy</h5>
            </div>
            <div class="card-body px-4">
                @if (overview.TopProducts != null && overview.TopProducts.Any())
                {
                    int rank = 1;
                    foreach (var item in overview.TopProducts)
                    {
                        <div class="top-product-item d-flex align-items-center mb-2">
                            <div class="product-img-wrapper me-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="img-fluid rounded" alt="" style="object-fit: cover; width: 100%; height: 100%;">
                                }
                                else
                                {
                                    <i class="bi bi-box text-muted"></i>
                                }
                            </div>
                            <div class="flex-grow-1 min-vw-0">
                                <h6 class="mb-0 text-dark fw-bold text-truncate">@item.Name</h6>
                                <div class="d-flex align-items-center mt-1">
                                    <span class="badge bg-light text-muted border-0 p-0 me-2 small">Top @(rank++)</span>
                                    <span class="text-muted extra-small" style="font-size: 0.75rem;">Đã bán: <b class="text-dark">@item.QuantitySold</b></span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold text-primary d-block">@item.Revenue.ToString("N0")</span>
                                <small class="text-muted" style="font-size: 0.7rem;">xu</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <span class="text-muted italic">Chưa có dữ liệu bán hàng</span>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-trophy me-2 text-primary"></i>Top sản phẩm (biểu đồ)</h5>
            </div>
            <div class="card-body px-4">
                <canvas id="productChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const monthLabels = @Html.Raw(JsonSerializer.Serialize(chartData.MonthLabels, jsonOptions));
        const revenueByMonth = @Html.Raw(JsonSerializer.Serialize(chartData.RevenueByMonth, jsonOptions));
        const orderCountByMonth = @Html.Raw(JsonSerializer.Serialize(chartData.OrderCountByMonth, jsonOptions));
        const topProductNames = @Html.Raw(JsonSerializer.Serialize(chartData.TopProductNames, jsonOptions));
        const topProductQuantities = @Html.Raw(JsonSerializer.Serialize(chartData.TopProductQuantities, jsonOptions));

        function showChartError(canvasId) {
            var canvas = document.getElementById(canvasId);
            if (canvas) {
                canvas.insertAdjacentHTML('afterend', '<div class="text-danger small mt-2">⚠ Không tải được thư viện biểu đồ (Chart.js). Vui lòng kiểm tra kết nối mạng và tải lại trang.</div>');
            }
        }

        if (typeof Chart === 'undefined') {
            showChartError('revenueChart');
            showChartError('orderChart');
            showChartError('productChart');
        } else {

        // Revenue Chart
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: revenueByMonth,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,0.1)',
                    fill: true,
                    tension: 0.35
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        // Order Chart
        new Chart(document.getElementById('orderChart'), {
            type: 'bar',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Số đơn',
                    data: orderCountByMonth,
                    backgroundColor: '#ffc107'
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        // Product Chart
        new Chart(document.getElementById('productChart'), {
            type: 'bar',
            data: {
                labels: topProductNames,
                datasets: [{
                    label: 'Số lượng bán',
                    data: topProductQuantities,
                    backgroundColor: '#dc3545'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });

        }

        // Toggle Ngày / Tháng / Năm cho bảng thống kê doanh thu
        document.querySelectorAll('.period-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                fetch('@Url.Action("GetRevenueStats", "Dashboard")?period=' + this.dataset.period)
                    .then(res => res.json())
                    .then(data => {
                        const tbody = document.getElementById('revenueStatsBody');
                        tbody.innerHTML = '';
                        data.forEach(row => {
                            tbody.innerHTML += `<tr>
                                <td>${row.label}</td>
                                <td class="text-end">${row.orderCount}</td>
                                <td class="text-end fw-bold">${row.revenue.toLocaleString('vi-VN')}</td>
                            </tr>`;
                        });
                    });
            });
        });
    </script>
}
