@model WebBanHang.ViewModels.ReportVM
@{
    ViewData["Title"] = "Báo cáo";
}

<div class="pt-3 pb-4">
    <h3 class="fw-bold text-dark">Báo cáo doanh thu &amp; đơn hàng</h3>
    <p class="text-muted mb-0">Xem chi tiết theo khoảng thời gian tùy chọn</p>
</div>

<div class="card-modern mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-auto">
            <label class="form-label small fw-bold text-muted">Từ ngày</label>
            <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label small fw-bold text-muted">Đến ngày</label>
            <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-funnel me-2"></i>Xem báo cáo
            </button>
        </div>
    </form>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card-modern h-100">
            <div class="small text-muted mb-1">Tổng đơn hàng</div>
            <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card-modern h-100">
            <div class="small text-muted mb-1">Tổng doanh thu</div>
            <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("N0")</h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card-modern h-100">
            <div class="small text-muted mb-1">Đã xác nhận / Hoàn thành</div>
            <h3 class="fw-bold mb-0">@(Model.ConfirmedOrders + Model.CompletedOrders)</h3>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card-modern h-100">
            <div class="small text-muted mb-1">Đã hủy</div>
            <h3 class="fw-bold mb-0 text-danger">@Model.CancelledOrders</h3>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card-modern h-100">
            <h5 class="fw-bold mb-3">Đơn hàng theo trạng thái</h5>
            <div class="d-flex justify-content-between mb-2"><span class="badge-modern badge-secondary-modern">Draft</span><b>@Model.DraftOrders</b></div>
            <div class="d-flex justify-content-between mb-2"><span class="badge-modern badge-warning-modern">Confirmed</span><b>@Model.ConfirmedOrders</b></div>
            <div class="d-flex justify-content-between mb-2"><span class="badge-modern badge-success-modern">Completed</span><b>@Model.CompletedOrders</b></div>
            <div class="d-flex justify-content-between"><span class="badge-modern badge-danger-modern">Cancelled</span><b>@Model.CancelledOrders</b></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card-modern h-100">
            <h5 class="fw-bold mb-3">Top sản phẩm bán chạy trong khoảng thời gian</h5>
            @if (Model.TopProducts.Any())
            {
                <table class="table-modern w-100">
                    <thead><tr><th>Sản phẩm</th><th class="text-end">SL bán</th><th class="text-end">Doanh thu</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td class="text-end">@p.QuantitySold</td>
                                <td class="text-end fw-bold">@p.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">Không có dữ liệu bán hàng trong khoảng thời gian này.</p>
            }
        </div>
    </div>
</div>

<div class="card-modern">
    <h5 class="fw-bold mb-3">Danh sách đơn hàng</h5>
    <div class="table-responsive">
        <table class="table-modern w-100">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Any())
                {
                    foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>#@order.OrderCode</td>
                            <td>@(order.Customer?.User?.FullName ?? "Khách hàng ẩn danh")</td>
                            <td>@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    var badge = order.Status switch
                                    {
                                        "Completed" => "badge-success-modern",
                                        "Confirmed" => "badge-warning-modern",
                                        "Cancelled" => "badge-danger-modern",
                                        _ => "badge-secondary-modern"
                                    };
                                }
                                <span class="badge-modern @badge">@order.Status</span>
                            </td>
                            <td class="text-end fw-bold">@((order.TotalAmount ?? 0).ToString("N0"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Không có đơn hàng nào trong khoảng thời gian này.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 d-flex justify-content-between align-items-center text-muted small">
        <span>Trang @Model.PageIndex / @Model.TotalPages</span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")">Trước</a>
                </li>
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
