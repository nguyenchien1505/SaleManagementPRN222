@model WebBanHang.ViewModels.UserManagementVM

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-4">
    <div>
        <h3 class="fw-bold text-dark">Quản lý người dùng</h3>
        <p class="text-muted mb-0">Theo dõi và quản lý tài khoản khách hàng</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/Users/Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Thêm người dùng
        </a>
    </div>
</div>

<div class="card-modern">
    <form asp-action="Index">
        <input type="hidden" asp-for="RoleFilter" />

        <div class="input-group mb-3" style="max-width:350px;">
            <span class="input-group-text bg-light border-end-0 rounded-start-pill">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input asp-for="SearchInput" type="text" class="form-control bg-light border-start-0 rounded-end-pill ps-0"
                   placeholder="Tìm kiếm theo tên, email, sđt...">
        </div>
        <div class="d-flex gap-2 mb-4">
            <div class="dropdown">
                <button class="btn btn-outline-secondary rounded-pill dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="bi bi-filter"></i> Lọc vai trò
                </button>
                <ul class="dropdown-menu">
                    <li><button type="button" class="dropdown-item" onclick="setRole('All')">Tất cả</button></li>
                    <li><button type="button" class="dropdown-item" onclick="setRole('Admin')">Admin</button></li>
                    <li><button type="button" class="dropdown-item" onclick="setRole('Sales')">Sales</button></li>
                    <li><button type="button" class="dropdown-item" onclick="setRole('Customer')">Customer</button></li>
                </ul>
            </div>
            <button type="submit" name="sortStatus" value="@Model.SortStatus" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-sort-down"></i> Sắp xếp Ngày
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table-modern w-100">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Email</th>
                    <th>Ngày đăng ký</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>

            <tbody>
                @if (Model?.Users != null && Model.Users.Any())
                {
                    foreach (var item in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @{
                                        var avatarUrl = !string.IsNullOrEmpty(item.Avatar) ? item.Avatar : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(item.FullName ?? item.Email)}&background=random";
                                    }
                                    <img src="@avatarUrl" class="rounded-circle me-3" width="40" height="40" alt="Avatar">
                                    <div>
                                        <div class="fw-bold">@(item.FullName ?? item.Email)</div>
                                        <div class="small text-muted">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.CreatedAt</td>
                            <td>
                                @if (item.Role == "Admin")
                                {
                                    <span class="badge-modern badge-danger-modern">Admin</span>
                                }
                                else if (item.Role == "Sales")
                                {
                                    <span class="badge-modern badge-warning-modern">Sales</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-info-modern">Khách hàng</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActived)
                                {
                                    <span class="badge-modern badge-success-modern">Hoạt động</span>
                                }
                                else if (item.IsActived == false && item.IsDeleted == false)
                                {
                                    <span class="badge-modern badge-secondnary-modern">Đã khóa</span>
                                }
                                else if (item.IsDeleted == true)
                                {
                                    <span class="badge-modern badge-danger-modern">Đã xóa</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsDeleted)
                                {
                                    <a asp-controller="Users"
                                       asp-action="Restore"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-icon btn-light rounded-circle text-success"
                                       title="Khôi phục">

                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </a>

                                    @if (item.Role != "Admin")
                                    {
                                        <a asp-controller="Users"
                                           asp-action="HardDelete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-icon btn-light rounded-circle text-danger"
                                           title="Xóa vĩnh viễn">

                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-icon btn-light rounded-circle"
                                       title="Sửa">

                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (item.Role != "Admin")
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-icon btn-light rounded-circle text-danger"
                                           title="Xóa mềm">

                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">Không tìm thấy người dùng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 text-center text-muted small">
        Hiển thị @Model.TotalUsers kết quả
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>

<script>
    // Frontend demo
    console.log("User Management Page Loaded");

    // Ví dụ bắt sự kiện nút sửa/xóa
    document.querySelectorAll(".btn-icon").forEach(btn => {
    btn.addEventListener("click", () => {
    console.log("Button clicked");
    });
    });
</script>
<script>

    function setRole(role) {
    document.getElementById("RoleFilter").value = role;
    document.forms[0].submit();
    }
</script>
<script>
    setTimeout(function () {
    var alert = document.querySelector('.alert');
    if (alert) {
    var bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
    bsAlert.close();
    }
    }, 3000);
</script>