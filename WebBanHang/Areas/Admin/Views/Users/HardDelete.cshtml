@model WebBanHang.ViewModels.DeleteUserVM

@{
    ViewData["Title"] = "Xóa vĩnh viễn người dùng";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Xóa vĩnh viễn người dùng
            </h4>
        </div>

        <div class="card-body">
            <div class="alert alert-danger">
                <strong>Cảnh báo:</strong>
                Thao tác này không thể hoàn tác.
                Người dùng sẽ bị xóa hoàn toàn khỏi database.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Tên người dùng</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Họ và tên</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Vai trò</dt>
                <dd class="col-sm-9">@Model.Role</dd>

                <dt class="col-sm-3">Ngày tạo</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt
                </dd>
            </dl>

            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="HardDeleteUser"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash3-fill me-2"></i>
                    Xác nhận xóa vĩnh viễn
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Hủy
                </a>
            </form>
        </div>
    </div>
</div>