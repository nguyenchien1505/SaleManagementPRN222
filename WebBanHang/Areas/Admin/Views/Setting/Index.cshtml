@model WebBanHang.ViewModels.SettingVM
@{
    ViewData["Title"] = "Cài đặt tài khoản";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="pt-3 pb-4">
    <h3 class="fw-bold text-dark">Cài đặt tài khoản</h3>
    <p class="text-muted mb-0">Cập nhật thông tin cá nhân và mật khẩu đăng nhập của bạn</p>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-modern">
            <div class="card-body p-4">
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Role" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Vai trò</label>
                        <input value="@Model.Role" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <hr class="my-4" />
                    <h6 class="fw-bold mb-3">Đổi mật khẩu <small class="text-muted fw-normal">(để trống nếu không muốn đổi)</small></h6>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-5">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
