@model WebBanHang.DAL.Entities.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.OrderId}";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <h4 class="mb-0 fw-bold">Đơn hàng #@Model.OrderId</h4>
        @{
            var (statusColor, statusText) = Model.Status switch
            {
                "Completed" => ("success", "Hoàn thành"),
                "Confirmed" => ("info", "Đã xác nhận"),
                "Shipping" => ("warning text-dark", "Đang giao hàng"), // 🌟 Màu cho Shipping
                "Draft" => ("secondary", "Chờ xác nhận"),
                "Cancelled" => ("danger", "Đã hủy"),
                _ => ("light text-dark", Model.Status ?? "Không rõ")
            };
        }
        <span class="badge bg-@statusColor">@statusText</span>
    </div>

    <div class="d-flex gap-2">
        <!-- 1. Trạng thái Draft -> Chuyển thành Confirmed -->
        @if (Model.Status == "Draft")
        {
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.OrderId" />
                <input type="hidden" name="newStatus" value="Confirmed" />
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Xác nhận đơn</button>
            </form>
        }

        <!-- 2. Trạng thái Confirmed -> Chuyển thành Shipping (Đang giao hàng) -->
        @if (Model.Status == "Confirmed")
        {
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.OrderId" />
                <input type="hidden" name="newStatus" value="Shipping" />
                <button type="submit" class="btn btn-warning text-dark"><i class="bi bi-truck"></i> Giao hàng ngay</button>
            </form>
        }

        <!-- 3. Trạng thái Shipping -> Chuyển thành Completed (Hoàn tất) -->
        @if (Model.Status == "Shipping")
        {
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.OrderId" />
                <input type="hidden" name="newStatus" value="Completed" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check-all"></i> Hoàn tất đơn hàng</button>
            </form>
        }

        <!-- Nút hủy đơn (Chỉ cho phép hủy khi chưa hoàn thành hoặc chưa hủy) -->
        @if (Model.Status != "Cancelled" && Model.Status != "Completed")
        {
            <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                <input type="hidden" name="id" value="@Model.OrderId" />
                <input type="hidden" name="newStatus" value="Cancelled" />
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Hủy đơn</button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">Danh sách sản phẩm</h6>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end pe-4">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(item.Product.ProductImages?.FirstOrDefault(i => i.IsPrimary == true)?.ImageUrl ?? "https://placehold.co/50")"
                                             class="rounded me-3 border" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://placehold.co/50'" />
                                        <div>
                                            <h6 class="mb-0">@item.Product.Name</h6>
                                            <small class="text-muted">Mã: @item.Product.Code</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@(item.UnitPrice.ToString("N0")) ₫</td>
                                <td class="text-end pe-4 fw-bold">@((item.Total).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-top">
                        <tr>
                            <td colspan="3" class="text-end pt-3">Tạm tính:</td>
                            <td class="text-end pe-4 pt-3">@((Model.SubTotal ?? 0m).ToString("N0")) ₫</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end border-0">Giảm giá:</td>
                            <td class="text-end pe-4 border-0 text-danger">-@((Model.DiscountAmount ?? 0m).ToString("N0")) ₫</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end border-0 pb-3"><h5 class="fw-bold mb-0">Tổng cộng:</h5></td>
                            <td class="text-end pe-4 border-0 pb-3"><h5 class="fw-bold text-primary mb-0">@((Model.TotalAmount ?? 0m).ToString("N0")) ₫</h5></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">Thông tin khách hàng</h6>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; font-size: 1.2rem; flex-shrink: 0;">
                        @(string.IsNullOrEmpty(Model.Customer?.FullName) ? "U" : Model.Customer.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@(Model.Customer?.FullName ?? "Khách hàng ẩn danh")</h6>
                        <small class="text-muted">Mã KH: #@Model.CustomerId</small>
                    </div>
                </div>
                <hr class="my-3">
                <div class="mb-2">
                    <small class="text-muted d-block">Email tài khoản</small>
                    <span>@(Model.Customer?.Email ?? "N/A")</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Số điện thoại nhận hàng</small>
                    <span>@(Model.ShippingPhone ?? "N/A")</span>
                </div>
            </div>
        </div>

        <!-- 🌟 THÔNG TIN THANH TOÁN MỚI BỔ SUNG -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">Thông tin thanh toán</h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">Phương thức thanh toán</small>
                    <span class="fw-bold text-dark"><i class="bi bi-wallet2 text-primary me-1"></i> @(string.IsNullOrEmpty(Model.PaymentMethod) ? "COD" : Model.PaymentMethod)</span>
                </div>
                <div class="mb-0">
                    <small class="text-muted d-block">Trạng thái thanh toán</small>
                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success mt-1">Đã thanh toán</span>
                    }
                    else if (Model.PaymentStatus == "Failed")
                    {
                        <span class="badge bg-danger mt-1">Thanh toán lỗi</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark mt-1">Chờ thanh toán</span>
                    }
                </div>
            </div>
        </div>

        <!-- Shipping Info -->
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0">Thông tin giao nhận</h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">Ngày đặt hàng</small>
                    <span>@(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                </div>
                <div class="alert alert-light border mt-3 mb-0 small">
                    <i class="bi bi-truck me-1 text-primary"></i> Địa chỉ giao hàng thực tế:<br>
                    <strong>@(Model.ShippingAddress ?? "Chưa cập nhật địa chỉ")</strong>
                </div>
            </div>
        </div>
    </div>
</div>