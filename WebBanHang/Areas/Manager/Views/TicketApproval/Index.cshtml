@model IEnumerable<WebBanHang.BLL.DTOs.TicketListItemDTO>

@{
    ViewData["Title"] = "Duyệt Yêu cầu CSKH";
    Layout = "_AdminLayout";
}

<div class="container-fluid p-4">
    <h4 class="fw-bold mb-4"><i class="bi bi-headset me-2 text-primary"></i>Yêu cầu chờ duyệt</h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="table-modern-wrapper">
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Mã Ticket</th>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Loại</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@t.TicketCode</td>
                            <td>@t.CustomerName</td>
                            <td>@t.ProductName</td>
                            <td>@(t.TicketType == "WarrantyRequest" ? "Bảo hành" : "Đổi/Trả")</td>
                            <td>@t.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <a asp-area="Manager" asp-controller="TicketApproval" asp-action="Details" asp-route-id="@t.TicketId"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-eye"></i> Xem & Duyệt
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Không có ticket nào chờ duyệt</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
