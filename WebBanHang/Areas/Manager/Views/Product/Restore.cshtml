@model WebBanHang.ViewModels.RestoreProductVM

@{
    ViewData["Title"] = "Khôi phục sản phẩm";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Khôi phục sản phẩm</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a asp-area="Manager"
               asp-controller="Product"
               asp-action="Index">
                Sản phẩm
            </a>
        </li>
        <li class="breadcrumb-item active">Khôi phục</li>
    </ol>

    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">
            <i class="fas fa-undo-alt me-2"></i>
            Xác nhận khôi phục
        </h4>

        <p class="mb-0">
            Bạn có chắc chắn muốn khôi phục sản phẩm này?
            Sau khi khôi phục, sản phẩm sẽ xuất hiện lại trong danh sách sản phẩm.
        </p>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-white fw-bold py-3">
            <i class="fas fa-box me-2 text-primary"></i>
            Thông tin sản phẩm
        </div>

        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Code)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Code)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Name)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.CategoryName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CategoryName)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.SellingPrice)
                </dt>
                <dd class="col-sm-9">
                    @Model.SellingPrice.ToString(
                        "N0",
                        new System.Globalization.CultureInfo("vi-VN")
                    ) VNĐ
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.StockQuantity)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.StockQuantity)
                </dd>

                <dt class="col-sm-3">
                    Trạng thái hiện tại
                </dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">
                        Đã xóa
                    </span>
                </dd>
            </dl>

            <form asp-area="Manager"
                  asp-controller="Product"
                  asp-action="Restore"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProductId" />

                <a asp-area="Manager"
                   asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-secondary me-2">
                    <i class="fas fa-arrow-left me-1"></i>
                    Quay lại
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-undo-alt me-1"></i>
                    Khôi phục sản phẩm
                </button>
            </form>
        </div>
    </div>
</div>
