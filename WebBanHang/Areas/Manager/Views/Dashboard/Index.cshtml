@model WebBanHang.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Quản trị hệ thống";
    Layout = "_AdminLayout";
}

<!-- SECTION 1: STATS CARDS (Doanh thu, Đơn hàng, Đang xử lý, Người dùng mới) -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Doanh thu tổng</h6>
            <h3 class="fw-bold mb-0">@(Model.TotalRevenue.ToString("N0")) VNĐ</h3>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Tổng đơn hàng</h6>
            <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Đang xử lý</h6>
            <h3 class="fw-bold mb-0">@Model.PendingOrders</h3>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Người dùng mới</h6>
            <h3 class="fw-bold mb-0">@Model.NewUsers</h3>
        </div>
    </div>
</div>

<!-- SECTION 8a: BỔ SUNG 2 KPI CARD MỚI (Tổng sản phẩm, Tổng khách hàng) -->
<div class="row g-4 mb-4">
    <div class="col-xl-6 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Tổng sản phẩm</h6>
            <h3 class="fw-bold mb-0">@Model.TotalProducts</h3>
        </div>
    </div>
    <div class="col-xl-6 col-md-6">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <h6 class="text-muted mb-1 text-uppercase small ls-1">Tổng khách hàng</h6>
            <h3 class="fw-bold mb-0">@Model.TotalCustomers</h3>
        </div>
    </div>
</div>

<!-- SECTION 8b: WIDGET THỐNG KÊ ĐƠN HÀNG THEO TRẠNG THÁI -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card-modern">
            <h5 class="mb-4 text-dark fw-bold">Thống kê đơn hàng theo trạng thái</h5>
            <div class="row text-center">
                <div class="col-md-4">
                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2">Draft</span>
                    <h4 class="fw-bold mt-2">@Model.DraftOrders</h4>
                </div>
                <div class="col-md-4">
                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2">Confirmed</span>
                    <h4 class="fw-bold mt-2">@Model.ConfirmedOrders</h4>
                </div>
                <div class="col-md-4">
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">Completed</span>
                    <h4 class="fw-bold mt-2">@Model.CompletedOrders</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 8c (Part 1): BIỂU ĐỒ DOANH THU & SỐ ĐƠN THEO THÁNG -->
<div class="row g-4 mb-4">
    <div class="col-xl-8 col-lg-7">
        <div class="card-modern">
            <h5 class="mb-4 text-dark fw-bold">Biểu đồ doanh thu (theo tháng)</h5>
            <div class="chart-area" style="height: 350px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-5">
        <div class="card-modern">
            <h5 class="mb-4 text-dark fw-bold">Số đơn theo tháng</h5>
            <div class="chart-area" style="height: 300px;">
                <canvas id="orderChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 8c (Part 2): TOP SẢN PHẨM BÁN CHẠY -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card-modern">
            <h5 class="mb-4 text-dark fw-bold">Top sản phẩm bán chạy</h5>
            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Số lượng bán</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td>@p.QuantitySold</td>
                                <td>@p.Revenue.ToString("N0") xu</td>
                            </tr>
                        }
                        @if (!Model.TopProducts.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu bán hàng</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- GIAO DỊCH GẦN ĐÂY -->
<div class="row mb-4">
    <div class="col-12">
        <div class="table-modern-wrapper">
            <h5 class="mb-4 text-dark fw-bold ps-2">Giao dịch gần đây</h5>
            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Số tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@order.OrderId</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <span>@order.CustomerName</span>
                                    </div>
                                </td>
                                <td>@(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                <td class="fw-bold">@((order.TotalAmount).ToString("N0")) xu</td>
                                <td>
                                    @if (order.Status == "Completed")
                                    {
                                        <span class="badge-modern badge-success-modern">Hoàn thành</span>
                                    }
                                    else if (order.Status == "Processing")
                                    {
                                        <span class="badge-modern badge-info-modern">Đang xử lý</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge-modern badge-danger-modern">Đã hủy</span>
                                    }
                                    else if (order.Status == "Pending")
                                    {
                                        <span class="badge-modern badge-warning-modern">Chờ xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern badge-secondary">@order.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" onclick="showTransactionDetail(@order.OrderId)" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-eye"></i> Xem
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Giao Dịch Đơn Hàng -->
<div class="modal fade" id="transactionDetailModal" tabindex="-1" aria-labelledby="transactionDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="transactionDetailModalLabel">
                    <i class="bi bi-receipt text-primary me-2"></i>Chi tiết Giao dịch Đơn hàng #<span id="txOrderCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Status & Date Header -->
                <div class="row g-3 mb-4 bg-light p-3 rounded-3 border">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Trạng thái đơn hàng</small>
                        <span id="txStatusBadge"></span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Ngày đặt hàng</small>
                        <span id="txOrderDate" class="fw-semibold text-dark"></span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Khách hàng</small>
                        <span id="txCustomerName" class="fw-semibold text-dark"></span>
                        <div id="txCustomerContact" class="small text-muted"></div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Địa chỉ giao hàng & Số ĐT</small>
                        <div id="txShippingInfo" class="fw-semibold text-dark"></div>
                    </div>
                </div>

                <!-- Products Table -->
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-box-seam me-2 text-primary"></i>Danh sách sản phẩm</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start">Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="txItemsList">
                            <!-- Items populated by JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Summary Total -->
                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <div class="bg-light p-3 rounded-3 border">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Tạm tính:</span>
                                <span id="txSubTotal" class="fw-semibold"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Giảm giá:</span>
                                <span id="txDiscount" class="text-danger fw-semibold"></span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between">
                                <strong class="text-dark">Tổng thanh toán:</strong>
                                <strong id="txTotalAmount" class="text-primary fs-5"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Cấu hình phông chữ & màu sắc mặc định cho Chart.js
        Chart.defaults.font.family = 'Inter';
        Chart.defaults.color = '#858796';

        // 1. Biểu đồ Doanh thu (Line Chart)
        var ctx = document.getElementById("revenueChart");
        var myLineChart = new Chart(ctx, {
        type: 'line',
        data: {
        labels: ["Th 1", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7", "Th 8", "Th 9", "Th 10", "Th 11", "Th 12"],
        datasets: [{
        label: "Doanh thu",
        lineTension: 0.4,
        backgroundColor: "rgba(67, 97, 238, 0.05)",
        borderColor: "rgba(67, 97, 238, 1)",
        pointRadius: 4,
        pointBackgroundColor: "#fff",
        pointBorderColor: "rgba(67, 97, 238, 1)",
        pointHoverRadius: 6,
        pointHoverBackgroundColor: "rgba(67, 97, 238, 1)",
        pointHoverBorderColor: "#fff",
        pointHitRadius: 10,
        pointBorderWidth: 2,
        data: @Html.Raw(Json.Serialize(Model.RevenueData)),
        fill: true
        }],
        },
        options: {
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        tooltip: {
        backgroundColor: '#232d3f',
        titleFont: { size: 13 },
        bodyFont: { size: 13 },
        padding: 10,
        cornerRadius: 8,
        displayColors: false,
        callbacks: {
        label: function (context) {
        return new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' xu';
        }
        }
        }
        },
        scales: {
        x: {
        grid: { display: false, drawBorder: false },
        ticks: { color: '#8c9097' }
        },
        y: {
        ticks: {
        color: '#8c9097',
        padding: 10,
        callback: function (value) { return value.toLocaleString() + ' xu'; }
        },
        grid: {
        color: "rgba(0,0,0,0.03)",
        borderDash: [5, 5],
        drawBorder: false
        }
        }
        }
        }
        });

        // 2. SECTION 8d: Biểu đồ Số đơn hàng theo tháng (Bar Chart)
        var ctxOrder = document.getElementById("orderChart");
        var myOrderChart = new Chart(ctxOrder, {
        type: 'bar',
        data: {
        labels: ["Th 1", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7", "Th 8", "Th 9", "Th 10", "Th 11", "Th 12"],
        datasets: [{
        label: "Số đơn hàng",
        data: @Html.Raw(Json.Serialize(Model.OrderCountData)),
        backgroundColor: "rgba(43, 189, 126, 0.7)",
        borderRadius: 6
        }]
        },
        options: {
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        x: {
        grid: { display: false, drawBorder: false },
        ticks: { color: '#8c9097' }
        },
        y: {
        beginAtZero: true,
        ticks: { precision: 0, color: '#8c9097' },
        grid: { color: "rgba(0,0,0,0.03)", borderDash: [5, 5] }
        }
        }
        }
        });

        // 3. Hàm AJAX hiển thị Chi tiết Giao dịch Đơn hàng gần đây
        function showTransactionDetail(orderId) {
            fetch(`/Admin/Dashboard/GetOrderDetail/${orderId}`)
                .then(response => {
                    if (!response.ok) throw new Error('Không tìm thấy giao dịch');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('txOrderCode').textContent = data.orderCode || data.orderId;
                    document.getElementById('txOrderDate').textContent = data.orderDate || 'N/A';
                    document.getElementById('txCustomerName').textContent = data.customerName;
                    document.getElementById('txCustomerContact').textContent = (data.customerEmail || '') + (data.customerPhone ? ' | ' + data.customerPhone : '');
                    document.getElementById('txShippingInfo').textContent = data.shippingAddress + ' (SĐT: ' + data.shippingPhone + ')';

                    // Format Status Badge
                    const statusEl = document.getElementById('txStatusBadge');
                    let statusBadge = '<span class="badge bg-secondary">' + data.status + '</span>';
                    if (data.status === 'Completed' || data.status === 'Paid') {
                        statusBadge = '<span class="badge bg-success px-3 py-2">Hoàn thành</span>';
                    } else if (data.status === 'Confirmed' || data.status === 'Processing') {
                        statusBadge = '<span class="badge bg-primary px-3 py-2">Đang xử lý / Đã xác nhận</span>';
                    } else if (data.status === 'Cancelled') {
                        statusBadge = '<span class="badge bg-danger px-3 py-2">Đã hủy</span>';
                    } else if (data.status === 'Draft' || data.status === 'Pending') {
                        statusBadge = '<span class="badge bg-warning text-dark px-3 py-2">Chờ xử lý</span>';
                    }
                    statusEl.innerHTML = statusBadge;

                    // Items List
                    const itemsBody = document.getElementById('txItemsList');
                    itemsBody.innerHTML = '';
                    if (data.items && data.items.length > 0) {
                        data.items.forEach(item => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="text-start">
                                    <div class="d-flex align-items-center">
                                        <img src="${item.imageUrl}" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                        <div>
                                            <div class="fw-semibold text-dark">${item.productName}</div>
                                            <small class="text-muted">${item.productCode ? 'Mã: ' + item.productCode : ''}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>${Number(item.unitPrice).toLocaleString('vi-VN')} xu</td>
                                <td class="fw-bold">${item.quantity}</td>
                                <td class="text-end fw-bold text-dark">${Number(item.total).toLocaleString('vi-VN')} xu</td>
                            `;
                            itemsBody.appendChild(tr);
                        });
                    } else {
                        itemsBody.innerHTML = '<tr><td colspan="4" class="text-muted py-3">Không có chi tiết sản phẩm</td></tr>';
                    }

                    // Format Summary
                    document.getElementById('txSubTotal').textContent = Number(data.subTotal).toLocaleString('vi-VN') + ' xu';
                    document.getElementById('txDiscount').textContent = '-' + Number(data.discountAmount).toLocaleString('vi-VN') + ' xu';
                    document.getElementById('txTotalAmount').textContent = Number(data.totalAmount).toLocaleString('vi-VN') + ' xu';

                    const modal = new bootstrap.Modal(document.getElementById('transactionDetailModal'));
                    modal.show();
                })
                .catch(err => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: err.message || 'Không thể tải chi tiết giao dịch này.'
                    });
                });
        }
    </script>
}