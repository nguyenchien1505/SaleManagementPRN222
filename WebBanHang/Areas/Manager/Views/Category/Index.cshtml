@model WebBanHang.ViewModels.CategoryManagementVM

@{
    ViewData["Title"] = "Quản lý danh mục";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-4">
    <div>
        <h3 class="fw-bold text-dark">Quản lý danh mục</h3>
        <p class="text-muted mb-0">Danh sách danh mục sản phẩm và trạng thái</p>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-2 mb-md-0 align-items-center">

        <form id="importExcelForm" asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="m-0">
            <input type="file" id="fileInput" name="file" accept=".xlsx" class="d-none" onchange="handleExcelUpload(this)" />
            <label for="fileInput" class="btn btn-info text-white rounded-pill px-4 shadow-sm m-0" style="cursor: pointer;">
                <i class="bi bi-upload me-2"></i> Nhập Excel
            </label>
        </form>

        <a asp-action="ExportExcel" class="btn btn-success rounded-pill px-4 shadow-sm m-0">
            <i class="bi bi-file-earmark-excel me-2"></i> Xuất Excel
        </a>

        <a asp-action="Create" method="get" class="btn btn-primary rounded-pill px-4 shadow-sm m-0">
            <i class="bi bi-plus-lg me-2"></i> Thêm danh mục
        </a>

    </div>
</div>


<div class="card-modern">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <form id="filterForm" asp-action="Index" method="post" class="d-flex">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-secondary"></i></span>
                <input type="text" asp-for="SearchInput" class="form-control bg-light border-start-0 ps-0" placeholder="Tìm kiếm danh mục..." style="min-width: 200px;">
                <select asp-for="StatusFilter" class="form-select bg-light border-start-0 rounded-end-pill ms-2" style="max-width: 150px;" onchange="this.form.submit()">
                    <option value="All">Tất cả trạng thái</option>
                    <option value="Active">Hoạt động</option>
                    <option value="Inactive">Tạm ẩn</option>
                </select>
            </div>

        </form>
    </div>

    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>
                        <button form="filterForm" type="submit" name="SortStatus" value="@Model.SortStatus" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-sort-down"></i> Tên danh mục
                        </button>
                    </th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.Name</td>
                        <td class="text-muted" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @item.Description
                        </td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge-modern badge-success-modern">Hoạt động</span>
                            }
                            else if (item.Status == "Deleted")
                            {
                                <span class="badge-modern badge-danger-modern">Đã xóa mềm</span>
                            }
                            else
                            {
                                <span class="badge-modern badge-secondary">Tạm ẩn</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">

                                    @if (item.Status == "Deleted")
                                    {
                                        <li>
                                            <form asp-action="Restore"
                                                  asp-route-id="@item.CategoryId"
                                                  method="post"
                                                  class="m-0">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item text-success">
                                                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                                                    Khôi phục
                                                </button>
                                            </form>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>

                                        <li>
                                            <form asp-action="HardDelete"
                                                  asp-route-id="@item.CategoryId"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn danh mục này? Dữ liệu sau khi xóa sẽ không thể khôi phục.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item text-danger">
                                                    <i class="bi bi-trash3-fill me-2"></i>
                                                    Xóa vĩnh viễn
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@item.CategoryId">
                                                <i class="bi bi-pencil me-2"></i>
                                                Chỉnh sửa
                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@item.CategoryId">
                                                <i class="bi bi-trash me-2"></i>
                                                Xóa
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        setTimeout(function () {
            var alert = document.querySelector('.alert');
            if (alert) {
                var bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }
        }, 3000);

        function handleExcelUpload(input) {
            if (input.files && input.files.length > 0) {
                var file = input.files[0];
                var fileName = file.name;
                var fileExtension = fileName.split('.').pop().toLowerCase();

                if (fileExtension !== 'xlsx') {
                    Swal.fire({
                        title: 'Định dạng không hợp lệ!',
                        text: 'Vui lòng chỉ chọn file Excel có đuôi .xlsx',
                        icon: 'error',
                        confirmButtonText: 'Đã hiểu'
                    });
                    input.value = ''; 
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận tải lên?',
                    html: `Bạn đang chuẩn bị nhập dữ liệu từ file:<br><b class="text-info">${fileName}</b>`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý, nhập ngay',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Đang xử lý dữ liệu...',
                            text: 'Vui lòng không đóng trình duyệt',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        document.getElementById('importExcelForm').submit();
                    } else {
                        input.value = '';
                    }
                });
            }
        }
    </script>
}