@using WebBanHang.DAL.Entities
@{
    ViewData["Title"] = "Nhập kho";
    var products = ViewBag.Products as List<Product>;
}

<div class="container px-4 py-4" style="max-width: 850px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Nhập Kho Hàng Hóa</h2>
            <p class="text-muted small m-0">Role tham gia: <span class="fw-bold text-dark">System</span> — nhập kho sẽ tự động tăng số lượng tồn thực tế.</p>
        </div>

        <form id="importInboundForm" asp-action="ImportInboundExcel" method="post" enctype="multipart/form-data" class="m-0">
            <input type="file" id="inboundExcelInput" name="file" accept=".xlsx" class="d-none" onchange="handleInboundExcelUpload(this)" />
            <label for="inboundExcelInput" class="btn btn-info text-white d-flex align-items-center gap-2 px-3 m-0 shadow-sm" style="border-radius: 10px; font-weight: 500; cursor: pointer;">
                <i class="bi bi-upload"></i> Nhập Excel hàng loạt
            </label>
        </form>
    </div>

    <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
        <form method="post" asp-action="Inbound">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 p-3 mb-4" style="border-radius: 10px;"></div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Sản phẩm cần nhập</label>
                <select name="productId" class="form-select custom-input py-2.5" required style="border-radius: 8px;">
                    <option value="" disabled selected>-- Chọn sản phẩm --</option>
                    @if (products != null)
                    {
                        foreach (var p in products)
                        {
                            <option value="@p.ProductId" data-supplier="@p.SupplierName">@p.Name (Tồn hiện tại: @p.StockQuantity)</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Số lượng nhập</label>
                <input type="number" name="quantity" class="form-control custom-input py-2" min="1" placeholder="Nhập số lượng thực tế lớn hơn 0..." required style="border-radius: 8px;" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Nhà cung cấp</label>
                <input type="text" name="supplierName" id="supplierNameInput" class="form-control custom-input py-2" maxlength="255" placeholder="Tự động điền theo sản phẩm, có thể sửa để cập nhật..." style="border-radius: 8px;" />
                <small class="text-muted">Tự động load nhà cung cấp hiện tại của sản phẩm. Chỉnh sửa nếu nhập từ nhà cung cấp mới.</small>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Ghi chú vận hành</label>
                <textarea name="note" class="form-control custom-input" rows="4" placeholder="Nhập lý do nhập kho..." style="border-radius: 8px;"></textarea>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 500;">
                    Xác nhận nhập kho
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: 8px; font-weight: 500; background-color: #6c757d;">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .custom-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Tự động điền Nhà cung cấp hiện tại khi chọn sản phẩm
        document.addEventListener("DOMContentLoaded", function () {
            var productSelect = document.querySelector('select[name="productId"]');
            var supplierInput = document.getElementById('supplierNameInput');

            if (productSelect && supplierInput) {
                productSelect.addEventListener('change', function () {
                    var selectedOption = productSelect.options[productSelect.selectedIndex];
                    var supplier = selectedOption ? selectedOption.getAttribute('data-supplier') : null;
                    supplierInput.value = supplier || '';
                });
            }
        });

        function handleInboundExcelUpload(input) {
            if (input.files && input.files.length > 0) {
                var file = input.files[0];
                var fileName = file.name;
                var fileExtension = fileName.split('.').pop().toLowerCase();

                if (fileExtension !== 'xlsx') {
                    Swal.fire({
                        title: 'Định dạng không hợp lệ!',
                        text: 'Vui lòng chỉ chọn file Excel có đuôi .xlsx',
                        icon: 'error',
                        confirmButtonText: 'Đã hiểu'
                    });
                    input.value = '';
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận nhập kho bằng Excel?',
                    html: `Hệ thống sẽ đọc file:<br><b class="text-info">${fileName}</b><br>và tiến hành cộng dồn số lượng kho hàng loạt.`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý, nhập ngay',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Đang xử lý dữ liệu...',
                            text: 'Vui lòng không đóng trình duyệt',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        document.getElementById('importInboundForm').submit();
                    } else {
                        input.value = '';
                    }
                });
            }
        }
    </script>
}