@model IEnumerable<WebBanHang.DAL.Entities.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-2 text-primary"></i>Lịch sử đơn hàng
            </h1>
            <p class="text-muted mb-0">Tra cứu và theo dõi trạng thái các đơn hàng bạn đã mua</p>
        </div>
        <div class="col-auto">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-cart-plus me-1"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 my-5 bg-white rounded-4 shadow-sm border-0">
            <div class="mb-4">
                <i class="bi bi-bag-x display-1 text-muted opacity-50"></i>
            </div>
            <h3 class="fw-bold text-secondary mb-2">Bạn chưa có đơn hàng nào</h3>
            <p class="text-muted mb-4">Hãy khám phá các sản phẩm tuyệt vời của chúng tôi và đặt hàng ngay!</p>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                <i class="bi bi-shop me-2"></i> Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 border-0 text-muted fw-semibold">Mã Đơn</th>
                                <th class="py-3 border-0 text-muted fw-semibold">Ngày đặt</th>
                                <th class="py-3 border-0 text-muted fw-semibold">Tổng tiền</th>
                                <th class="py-3 border-0 text-muted fw-semibold">Thanh toán</th>
                                <th class="py-3 border-0 text-muted fw-semibold">Trạng thái đơn</th>
                                <th class="pe-4 py-3 border-0 text-muted fw-semibold text-center">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-primary">@order.OrderCode</div>
                                        <small class="text-muted">@order.OrderDetails?.Count sản phẩm</small>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">@order.OrderDate?.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@order.OrderDate?.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">
                                            @((order.TotalAmount ?? 0m).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) đ
                                        </span>
                                    </td>
                                    <!-- 🌟 HIỂN THỊ PHƯƠNG THỨC & TRẠNG THÁI THANH TOÁN -->
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1 w-fit">
                                                <i class="bi bi-wallet2 me-1"></i> @(string.IsNullOrEmpty(order.PaymentMethod) ? "COD" : order.PaymentMethod)
                                            </span>
                                            @if (order.PaymentStatus == "Paid")
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 w-fit">Đã thanh toán</span>
                                            }
                                            else if (order.PaymentStatus == "Failed")
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1 w-fit">Thanh toán lỗi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1 w-fit">Chờ thanh toán</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Draft":
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">Chờ xác nhận</span>
                                                break;
                                            case "Confirmed":
                                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">Đã xác nhận</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Hoàn thành</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-center">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOrder-@order.OrderId" aria-expanded="false" aria-controls="collapseOrder-@order.OrderId">
                                            Xem <i class="bi bi-chevron-down ms-1"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr>
                                    <td colspan="6" class="p-0 border-0">
                                        <div class="collapse" id="collapseOrder-@order.OrderId">
                                            <div class="bg-light p-4 border-bottom row g-3">

                                                <!-- Cột bên trái: Bảng danh sách hàng hóa mua -->
                                                <div class="col-lg-7">
                                                    <h6 class="fw-bold mb-3"><i class="bi bi-card-list me-2 text-primary"></i>Chi tiết sản phẩm</h6>
                                                    <div class="table-responsive bg-white rounded-3 shadow-sm border">
                                                        <table class="table table-sm table-borderless mb-0 align-middle">
                                                            <thead class="table-light">
                                                                <tr class="small text-secondary">
                                                                    <th class="ps-3 py-2">Sản phẩm</th>
                                                                    <th class="text-center py-2">Số lượng</th>
                                                                    <th class="text-end pe-3 py-2">Đơn giá</th>
                                                                    <th class="text-end pe-3 py-2">Tổng</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (order.OrderDetails != null)
                                                                {
                                                                    foreach (var detail in order.OrderDetails)
                                                                    {
                                                                        <tr class="border-bottom small text-secondary">
                                                                            <td class="ps-3 py-2 fw-medium text-dark">
                                                                                @detail.Product?.Name
                                                                            </td>
                                                                            <td class="text-center py-2">@detail.Quantity</td>
                                                                            <td class="text-end pe-3 py-2">
                                                                                @detail.UnitPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ
                                                                            </td>
                                                                            <td class="text-end pe-3 py-2 fw-semibold text-dark">
                                                                                @detail.Total.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- Cột bên phải: Hiển thị thông tin vận chuyển, phương thức thanh toán chi tiết -->
                                                <div class="col-lg-5">
                                                    <h6 class="fw-bold mb-3"><i class="bi bi-truck me-2 text-primary"></i>Thông tin vận chuyển & Thanh toán</h6>
                                                    <div class="bg-white p-3 rounded-3 shadow-sm border small">
                                                        <div class="mb-2">
                                                            <span class="text-muted d-block">Số điện thoại nhận hàng:</span>
                                                            <strong class="text-dark">@(order.ShippingPhone ?? "N/A")</strong>
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="text-muted d-block">Địa chỉ nhận hàng thực tế:</span>
                                                            <strong class="text-dark">@(order.ShippingAddress ?? "Chưa cập nhật địa chỉ")</strong>
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="text-muted d-block">Hình thức thanh toán:</span>
                                                            <strong class="text-primary"><i class="bi bi-credit-card me-1"></i> @(string.IsNullOrEmpty(order.PaymentMethod) ? "COD" : order.PaymentMethod)</strong>
                                                        </div>

                                                        <!-- Hiển thị thông tin Promotion/Voucher đã dùng -->
                                                        <div class="mb-3">
                                                            <span class="text-muted d-block">Mã giảm giá đã áp dụng:</span>
                                                            @if (order.DiscountAmount > 0)
                                                            {
                                                                <span class="badge bg-success-subtle text-success border border-success border-dashed px-2 py-1.5 mt-1">
                                                                    <i class="bi bi-ticket-perforated-fill me-1"></i> Đã giảm -@(order.DiscountAmount?.ToString("N0")) đ
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-secondary italic fs-7">Không sử dụng mã giảm giá</span>
                                                            }
                                                        </div>

                                                        <hr class="my-2">

                                                        <!-- Bảng tóm tắt dòng tiền cụ thể -->
                                                        <div class="d-flex justify-content-between text-muted mb-1 fs-7">
                                                            <span>Tạm tính tiền hàng:</span>
                                                            <span>@((order.SubTotal ?? 0m).ToString("N0")) đ</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between text-success mb-2 fs-7">
                                                            <span>Giảm giá:</span>
                                                            <span>-@((order.DiscountAmount ?? 0m).ToString("N0")) đ</span>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                            <div>
                                                                <span class="text-dark fw-bold">Tổng thanh toán:</span>
                                                                <div class="fw-bold text-primary fs-5">@((order.TotalAmount ?? 0m).ToString("N0")) đ</div>
                                                            </div>

                                                            @if (order.Status == "Draft")
                                                            {
                                                                <form asp-area="Customer" asp-controller="Order" asp-action="UpdateStatus" method="post" id="form-cancel-@order.OrderId">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@order.OrderId" />
                                                                    <input type="hidden" name="status" value="Cancelled" />
                                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium"
                                                                            onclick="confirmCancelOrder(@order.OrderId, '@order.OrderCode')">
                                                                        <i class="bi bi-x-circle me-1"></i> Hủy đơn hàng
                                                                    </button>
                                                                </form>
                                                            }
                                                            else if (order.Status == "Cancelled")
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1"><i class="bi bi-info-circle me-1"></i> Đơn đã hủy</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted italic small"><i class="bi bi-lock-fill text-success me-1"></i> Đang xử lý - Không thể hủy</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .badge {
        font-weight: 500;
        font-size: 0.75rem;
    }

    .bg-warning-subtle {
        background-color: #fff3cd !important;
        color: #664d03 !important;
        border: 1px solid #ffecb5;
    }

    .bg-info-subtle {
        background-color: #cff4fc !important;
        color: #087990 !important;
        border: 1px solid #b6effc;
    }

    .bg-success-subtle {
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
        border: 1px solid #badbcc;
    }

    .bg-danger-subtle {
        background-color: #f8d7da !important;
        color: #842029 !important;
        border: 1px solid #f5c2c7;
    }

    .table th {
        font-size: 0.8rem;
        letter-spacing: 0.3px;
    }

    .italic {
        font-style: italic;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .fs-7 {
        font-size: 0.825rem;
    }
</style>

@section Scripts {
    <script>
        function confirmCancelOrder(orderId, orderCode) {
            Swal.fire({
                title: 'Xác nhận hủy đơn?',
                html: `Bạn có chắc chắn muốn hủy đơn hàng <b>${orderCode}</b> không?<br><span class="text-muted small">Hành động này không thể hoàn tác sau khi thực hiện.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý hủy đơn',
                cancelButtonText: 'Kiểm tra lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('form-cancel-' + orderId).submit();
                }
            });
        }
    </script>
}