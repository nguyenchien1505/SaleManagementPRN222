@model WebBanHang.ViewModels.ProductDetailVM
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = Model.Name;

    // 🌟 ĐÃ SỬA: Đọc trực tiếp từ Session để kiểm tra trạng thái đăng nhập
    int? sessionUserId = Context.Session.GetInt32("UserId");
    bool isUserLoggedIn = sessionUserId.HasValue;

    // Đường dẫn trang Login ngoài gốc hệ thống
    string loginUrl = Url.Action("Login", "Account", new { area = "", returnUrl = Context.Request.Path + Context.Request.QueryString })!;

    var primaryImg = Model.Images.FirstOrDefault(p => p.IsPrimary == true)?.ImageUrl ?? (Model.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png");
    var otherImages = Model.Images.Where(p => p.ImageUrl != primaryImg).ToList();
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="breadcrumb-container mb-4">
        <ol class="breadcrumb bg-transparent p-0 mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-area="" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">@Model.Categories.FirstOrDefault()?.Name</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Vùng hiển thị hình ảnh -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-3 overflow-hidden rounded-4">
                <img id="mainImage" src="@primaryImg" class="img-fluid w-100 object-fit-cover" style="height: 500px;" alt="@Model.Name">
            </div>
            @if (otherImages.Any() || primaryImg != "/images/no-image.png")
            {
                <div class="d-flex gap-2 overflow-auto pb-2">
                    <img src="@primaryImg" class="rounded-3 cursor-pointer border border-primary opacity-100" style="width: 80px; height: 80px; object-fit: cover;" onclick="changeImage(this.src, this)">
                    @foreach (var img in otherImages)
                    {
                        <img src="@img.ImageUrl" class="rounded-3 cursor-pointer border-0 opacity-50 product-thumb" style="width: 80px; height: 80px; object-fit: cover;" onclick="changeImage(this.src, this)">
                    }
                </div>
            }
        </div>

        <!-- Vùng hiển thị thông tin & Mua hàng -->
        <div class="col-lg-6">
            <div class="ps-lg-4">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-tag-fill me-1"></i> @Model.Categories.FirstOrDefault()?.Name
                    </span>
                    @if (Model.StockQuantity > 0 && Model.Status == "Active")
                    {
                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-semibold ms-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Còn hàng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2 fw-semibold ms-2">
                            <i class="bi bi-x-circle-fill me-1"></i> Hết hàng / Tạm ngưng
                        </span>
                    }
                </div>

                <h1 class="display-5 fw-bold mb-3 text-dark">@Model.Name</h1>

                <div class="mb-4">
                    <div class="d-flex align-items-end gap-2">
                        <h2 class="text-primary fw-bold mb-0 display-6">
                            @((Model.SellingPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) <small class="fs-4">xu</small>
                        </h2>
                    </div>
                </div>

                <p class="lead text-muted mb-4">
                    @(Model.Description?.Length > 150 ? Model.Description.Substring(0, 150) + "..." : Model.Description)
                </p>

                @if (Model.StockQuantity > 0 && Model.Status == "Active")
                {
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Số lượng:</label>
                        <div class="input-group" style="width: 140px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="decrementQty()">-</button>
                            <input type="number" class="form-control text-center border-secondary fw-bold" id="quantityInput"
                                   value="1" min="1" max="@Model.StockQuantity" onchange="validateQty()" oninput="validateQty()">
                            <button class="btn btn-outline-secondary" type="button" onclick="incrementQty()">+</button>
                        </div>
                        <div class="form-text mt-2 text-muted" id="stockStatus">Còn @Model.StockQuantity sản phẩm trong kho</div>
                    </div>

                    <div class="d-flex gap-3 mt-5">
                        <!-- Nút Thêm vào giỏ -->
                        <button type="button" onclick="addToCart(@Model.ProductId)" class="btn btn-primary btn-lg rounded-pill px-5 flex-grow-1 shadow-sm fw-bold">
                            <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ
                        </button>

                        <!-- Form Mua ngay gửi dữ liệu trực tiếp sang luồng Checkout đơn lẻ của OrdersController -->
                        <form id="buyNowForm" asp-area="Customer" asp-controller="Orders" asp-action="Checkout" method="post" class="flex-grow-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" id="hiddenQuantity" value="1" />

                            <button type="button" class="btn btn-outline-primary btn-lg rounded-pill w-100 fw-bold" onclick="confirmPurchaseDetail()">
                                Mua ngay
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning rounded-3 mt-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Sản phẩm này hiện đang hết hàng hoặc ngừng kinh doanh.
                    </div>
                    <button class="btn btn-secondary btn-lg rounded-pill px-5 mt-3 disabled">Hết hàng</button>
                }

                <!-- Các tiện ích đính kèm -->
                <div class="row mt-5 g-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-truck fs-4 me-3 text-primary"></i>
                            <span class="small">Giao hàng nhanh toàn quốc</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-shield-check fs-4 me-3 text-primary"></i>
                            <span class="small">Bảo hành chính hãng</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-arrow-return-left fs-4 me-3 text-primary"></i>
                            <span class="small">Đổi trả trong 7 ngày</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-headset fs-4 me-3 text-primary"></i>
                            <span class="small">Hỗ trợ 24/7</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khối Tabs mô tả sản phẩm -->
    <div class="row mt-5 pt-5">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs border-bottom-0" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold px-4 py-3" data-bs-toggle="tab" data-bs-target="#description" type="button">Mô tả chi tiết</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold px-4 py-3" data-bs-toggle="tab" data-bs-target="#specs" type="button">Thông số kỹ thuật</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold px-4 py-3" data-bs-toggle="tab" data-bs-target="#reviews" type="button">Đánh giá</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <h5 class="fw-bold mb-4">Chi tiết sản phẩm</h5>
                            <p class="text-secondary lh-lg mb-0">
                                @(string.IsNullOrEmpty(Model.Description) ? "Đang cập nhật mô tả..." : Model.Description)
                            </p>
                        </div>
                        <div class="tab-pane fade" id="specs" role="tabpanel">
                            <table class="table table-striped table-hover rounded-3 overflow-hidden mb-0">
                                <tbody>
                                    <tr>
                                        <th class="ps-4" style="width: 30%">Mã sản phẩm</th>
                                        <td>@Model.Code</td>
                                    </tr>
                                    <tr>
                                        <th class="ps-4">Danh mục</th>
                                        <td>@Model.Categories.FirstOrDefault()?.Name</td>
                                    </tr>
                                    <tr>
                                        <th class="ps-4">Ngày đăng</th>
                                        <td>(@Model.CreatedDate?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <div class="text-center py-5">
                                <i class="bi bi-chat-square-quote fs-1 text-muted mb-3 opacity-50"></i>
                                <p class="text-muted mb-3">Chưa có đánh giá nào cho sản phẩm này.</p>
                                <button class="btn btn-outline-primary rounded-pill btn-sm px-4">Viết đánh giá đầu tiên</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-elevate:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .product-thumb:hover {
        opacity: 1 !important;
        border-color: var(--bs-primary) !important;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

@section Scripts {
    <script>
        // 🌟 ĐÃ SỬA: Nhận diện trạng thái đăng nhập qua biến đồng bộ Session mới
        var isUserLoggedIn = @Json.Serialize(isUserLoggedIn);
        var loginUrl = '@Html.Raw(loginUrl)';

        function redirectToLogin() {
            Swal.fire({
                title: 'Chưa đăng nhập',
                text: 'Vui lòng đăng nhập tài khoản để thực hiện mua hàng.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đăng nhập ngay',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = loginUrl;
                }
            });
        }

        // 🌟 ĐÃ SỬA: Chuẩn hóa nút Mua ngay chạy submit trực tiếp Form thay vì gọi nhầm Ajax vào Giỏ hàng
        function confirmPurchaseDetail() {
            if (!isUserLoggedIn) {
                redirectToLogin();
                return;
            }

            var qty = document.getElementById('quantityInput').value;

            Swal.fire({
                title: 'Xác nhận mua ngay?',
                text: "Đơn đặt hàng sẽ được khởi tạo lập tức với số lượng chọn mua. Bạn có chắc chắn muốn tiến hành?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xác nhận đặt hàng',
                cancelButtonText: 'Kiểm tra lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gán số lượng sang thẻ ẩn input và kích hoạt submit form
                    document.getElementById('hiddenQuantity').value = qty;
                    document.getElementById('buyNowForm').submit();
                }
            });
        }

        function changeImage(src, element) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.product-thumb, .cursor-pointer').forEach(el => {
                el.classList.add('opacity-50');
                el.classList.remove('border', 'border-primary', 'opacity-100');
            });
            element.classList.remove('opacity-50');
            element.classList.add('border', 'border-primary', 'opacity-100');
        }

        function incrementQty() {
            var input = document.getElementById('quantityInput');
            var max = parseInt(input.getAttribute('max'));
            var value = parseInt(input.value) || 0;
            if (value < max) {
                input.value = value + 1;
            } else {
                Swal.fire({
                    title: 'Thông báo',
                    text: 'Bạn đã chọn tối đa số lượng hiện có trong kho.',
                    icon: 'info',
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        }

        function decrementQty() {
            var input = document.getElementById('quantityInput');
            var value = parseInt(input.value) || 0;
            if (value > 1) input.value = value - 1;
        }

        function validateQty() {
            var input = document.getElementById('quantityInput');
            var max = parseInt(input.getAttribute('max'));
            var value = parseInt(input.value);

            if (value > max) {
                Swal.fire({
                    title: 'Vượt quá số lượng',
                    text: 'Rất tiếc, cửa hàng hiện tại chỉ còn ' + max + ' sản phẩm trong kho.',
                    icon: 'warning',
                    confirmButtonText: 'Đồng ý'
                });
                input.value = max;
            } else if (value < 1 || isNaN(value)) {
                input.value = 1;
            }
        }

        // Luồng Thêm vào giỏ hàng (AJAX) giữ nguyên
        function addToCart(productId) {
            if (!isUserLoggedIn) {
                redirectToLogin();
                return;
            }

            var qty = document.getElementById('quantityInput').value;

            $.ajax({
                // Đảm bảo trỏ đúng đến Area Customer nếu cấu hình Route yêu cầu
                url: '/Customer/Cart/AddToCart',
                type: 'POST',
                data: {
                    productId: productId,
                    quantity: qty
                },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: 'Đã thêm sản phẩm vào giỏ hàng thành công',
                            icon: 'success',
                            showConfirmButton: false,
                            timer: 1000,
                            timerProgressBar: true
                        }).then(() => {
                            if (typeof updateCartBadge === "function") {
                                updateCartBadge();
                            } else {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire('Lỗi!', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ. Vui lòng thử lại.', 'error');
                }
            });
        }
    </script>
}