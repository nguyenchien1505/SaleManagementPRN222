@model WebBanHang.DAL.Entities.SupportTicket

@{
    ViewData["Title"] = "Chi tiết yêu cầu " + Model.TicketCode;
    bool canCancel = Model.Status == "New" || Model.Status == "InProgress" || Model.Status == "WaitingCustomer";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0"><i class="bi bi-headset me-2 text-primary"></i>@Model.TicketCode</h1>
        <a asp-area="Customer" asp-controller="Ticket" asp-action="MyTickets" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">Loại yêu cầu</small>
                    <strong>@(Model.TicketType == "WarrantyRequest" ? "Bảo hành" : "Đổi / Trả hàng")</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Trạng thái</small>
                    <strong>@Model.Status</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Sản phẩm</small>
                    <strong>@Model.OrderDetail.Product.Name</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Đơn hàng</small>
                    <strong>@Model.Order.OrderCode</strong>
                </div>
                <div class="col-12">
                    <small class="text-muted d-block">Mô tả</small>
                    <p class="mb-0">@Model.Description</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.RejectReason))
                {
                    <div class="col-12">
                        <small class="text-muted d-block">Lý do từ chối</small>
                        <p class="text-danger mb-0">@Model.RejectReason</p>
                    </div>
                }
            </div>

            @if (Model.TicketAttachments != null && Model.TicketAttachments.Any())
            {
                <hr class="my-4" />
                <h6 class="fw-bold mb-3">Ảnh minh chứng</h6>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.TicketAttachments)
                    {
                        <a href="@img.FileUrl" target="_blank">
                            <img src="@img.FileUrl" style="width:110px;height:110px;object-fit:cover;" class="rounded-3 border" />
                        </a>
                    }
                </div>
            }

            @if (canCancel)
            {
                <hr class="my-4" />
                <form asp-area="Customer" asp-controller="Ticket" asp-action="Cancel" method="post" id="form-cancel-ticket">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.TicketId" />
                    <button type="button" class="btn btn-outline-danger rounded-pill px-4" onclick="confirmCancelTicket()">
                        <i class="bi bi-x-circle me-1"></i> Hủy yêu cầu
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmCancelTicket() {
            Swal.fire({
                title: 'Xác nhận hủy yêu cầu?',
                text: 'Hành động này không thể hoàn tác.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Kiểm tra lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('form-cancel-ticket').submit();
                }
            });
        }
    </script>
}
