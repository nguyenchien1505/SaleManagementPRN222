<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SalesM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBanHang.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        .notification-container {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            max-width: 450px;
        }

        .swal2-popup {
            border-radius: 15px !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top glass-effect">
            <div class="container">

                <a class="navbar-brand" href="#">
                    <i class="bi bi-graph-up-arrow"></i> PRN222
                </a>

                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">

                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-action="Index" asp-controller="Home">Trang chủ</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-action="Index" asp-controller="Product">Sản phẩm</a>
                        </li>
                    </ul>


                    <ul class="navbar-nav align-items-center gap-2">
                        @if (Context.Session.GetInt32("UserId") == null)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-modern btn-sm" asp-action="Login" asp-controller="Account" asp-area="">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-outline-modern btn-sm" asp-action="Register" asp-controller="Account" asp-area="">
                                    Đăng ký
                                </a>
                            </li>

                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                         style="width:32px;height:32px;">
                                        @Context.Session.GetString("Role")?.Substring(0, 1).ToUpper()
                                    </div>

                                    <span>@Context.Session.GetString("FullName")</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg"
                                    style="border-radius:12px;">

                                    <li>
                                        <h6 class="dropdown-header">
                                            @Context.Session.GetString("Email")
                                        </h6>
                                    </li>

                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            @Context.Session.GetString("Role")
                                        </span>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>


                                    @* MENU ĐIỀU HƯỚNG DÀNH CHO Manager *@
                                    @if (Context.Session.GetString("Role") == "Manager")
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>
                                                Trang Quản trị (Admin)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    @* MENU ĐIỀU HƯỚNG KHO DÀNH CHO Manager HOẶC SALES *@
                                    @if (Context.Session.GetString("Role") == "Manager" || Context.Session.GetString("Role") == "Sales")
                                    {
                                        <li>
                                            <a class="dropdown-item text-primary fw-bold" asp-area="Manager" asp-controller="Inventory" asp-action="Stock">
                                                <i class="bi bi-boxes me-2"></i>
                                                Xem Tồn Kho (Stock)
                                            </a>
                                        </li>

                                        @if (Context.Session.GetString("Role") == "Manager")
                                        {
                                            <li>
                                                <a class="dropdown-item text-success fw-bold" asp-area="Manager" asp-controller="Inventory" asp-action="Inbound">
                                                    <i class="bi bi-download me-2"></i>
                                                    Nhập Kho (Inbound)
                                                    Chin
                                                </a>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    @if (Context.Session.GetString("Role") == "Customer")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="Customer" asp-controller="Account" asp-action="Profile">
                                                <i class="bi bi-person me-2"></i>
                                                Hồ sơ
                                            </a>
                                        </li>



                                        <li><a class="dropdown-item" asp-area="Customer" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3 me-2"></i> Giỏ hàng của tôi</a></li>

                                        <li><a class="dropdown-item" asp-area="Customer" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i> Đơn hàng của tôi </a></li>

                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="m-0 p-0">
                                            <button type="submit"
                                                    class="dropdown-item text-danger border-0 bg-transparent">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="notification-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-lg border-0 mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-lg border-0 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <main role="main" class="pb-3" style="min-height:80vh;padding-top:100px;">
        @RenderBody()
    </main>

    <footer class="modern-footer text-muted">
        <div class="container border-top pt-4 mt-4 text-center">
            <p>&copy; 2026 SalesM. Đã đăng ký bản quyền.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
           function confirmPurchase(productId, productName, price) {
            Swal.fire({
                title: 'Xác nhận mua hàng?',
                html: `Bạn muốn mua <b>${productName}</b> với giá <span class="text-primary">${price} đ</span>?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý, mua ngay!',
                cancelButtonText: 'Để sau',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Nếu có form mua ngay trên view, nó sẽ submit tại đây
                    var form = document.getElementById('form-checkout-' + productId);
                    if(form) form.submit();
                }
            });
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>