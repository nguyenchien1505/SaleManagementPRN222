@{
    // Tự động nhận diện tên Controller trên trình duyệt để kích hoạt class active động
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="~/css/admin.css">
    <link class="jsbin" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap">
</head>
<body>

    <nav class="sidebar" id="sidebar">

        <div class="sidebar-header">
            <a href="#" class="sidebar-brand">
                <i class="bi bi-shield-lock-fill"></i>
            </a>
        </div>

        <ul class="sidebar-menu p-0">

            <li class="nav-item">
                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    Tổng quan
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Product" ? "active" : "")" asp-area="Manager" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i>
                    Sản phẩm
                </a>
            </li>

            <li class="nav-item">

                <a class="nav-link @(currentController == "Category" ? "active" : "")" asp-area="Manager" asp-controller="Category" asp-action="Index">

                    <i class="bi bi-grid-fill"></i>
                    Danh mục
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Promotion" ? "active" : "")" asp-area="Manager" asp-controller="Promotion" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    Mã giảm giá
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Inventory" ? "active" : "")" asp-area="Manager" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes"></i>
                    Quản lý kho
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Orders" ? "active" : "")" asp-area="Manager" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    Đơn hàng
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    Người dùng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "AuditLog" ? "active" : "")" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">
                    <i class="bi bi-clock-history"></i>
                    Audit Log
                </a>
            </li>

            @* <li class="nav-item">
                <a class="nav-link @(currentController == "Report" ? "active" : "")" asp-area="Admin" asp-controller="Report" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    Báo cáo
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Setting" ? "active" : "")" asp-area="Admin" asp-controller="Setting" asp-action="Index">
                    <i class="bi bi-gear-fill"></i>
                    Cài đặt
                </a>
            </li> *@

        </ul>

        <div class="sidebar-footer">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="nav-link text-primary fw-semibold">
                <i class="bi bi-shop me-2"></i>
                Xem cửa hàng
            </a>
        </div>

    </nav>

    <div class="main-content" id="content">

        <div class="top-bar">

            <button class="btn btn-outline-secondary d-md-none" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <h4 class="m-0"></h4>

            <div class="user-profile dropdown">
                <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="text-end d-none d-sm-block me-3">
                        <small class="d-block text-secondary mb-0" style="font-size:0.75rem;">
                            Xin chào, 
                        </small>
                        <span class="fw-bold text-dark">
                            @Context.Session.GetString("FullName")
                        </span>
                    </div>

                    <div class="user-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                        @(Context.Session.GetString("Role")?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                </a>

                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg" style="border-radius:12px; min-width: 200px;">
                    <li>
                        <h6 class="dropdown-header">
                            @(Context.Session.GetString("Email") ?? "admin@system.com")
                        </h6>
                    </li>
                    <li>
                        <span class="dropdown-item-text small text-muted">
                            @(Context.Session.GetString("Role") ?? "Admin")
                        </span>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger fw-bold" asp-area="@(Context.Session.GetString("Role") == "Manager" ? "Manager" : "Admin")" asp-controller="@(Context.Session.GetString("Role") == "Manager" ? "Dashboard" : "Users")" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Trang Quản trị (Admin)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item text-primary fw-bold" asp-area="Customer" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-shop me-2"></i>
                            Xem cửa hàng
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="m-0 p-0">
                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

        </div>

        <div class="container-fluid p-0">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle sidebar mobile
        document.addEventListener("DOMContentLoaded", function () {

        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("sidebar");
        const content = document.getElementById("content");

        toggleBtn?.addEventListener("click", function () {
        sidebar.classList.toggle("active");
        content.classList.toggle("active");
        });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>