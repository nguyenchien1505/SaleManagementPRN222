@{
    // Tự động nhận diện tên Controller trên trình duyệt để kích hoạt class active động
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="~/css/admin.css">
    <link class="jsbin" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap">
</head>
<body>

    <nav class="sidebar" id="sidebar">

        <div class="sidebar-header">
            <a href="#" class="sidebar-brand">
                <i class="bi bi-shield-lock-fill"></i>
            </a>
        </div>

        <ul class="sidebar-menu p-0">

            <li class="nav-item">
                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    Tổng quan
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Employee" ? "active" : "")" asp-area="Admin" asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    Nhân viên
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Product" ? "active" : "")" asp-area="Admin" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i>
                    Sản phẩm
                </a>
            </li>

            <li class="nav-item">

                <a class="nav-link" href="/Admin/Category/Index">

                <a class="nav-link @(currentController == "Category" ? "active" : "")" asp-area="Admin" asp-controller="Category" asp-action="Index">

                    <i class="bi bi-grid-fill"></i>
                    Danh mục
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Promotion" ? "active" : "")" asp-area="Admin" asp-controller="Promotion" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    Mã giảm giá
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Inventory" ? "active" : "")" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes"></i>
                    Quản lý kho
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    Người dùng
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Report" ? "active" : "")" asp-area="Admin" asp-controller="Report" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    Báo cáo
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Setting" ? "active" : "")" asp-area="Admin" asp-controller="Setting" asp-action="Index">
                    <i class="bi bi-gear-fill"></i>
                    Cài đặt
                </a>
            </li>

        </ul>

        <div class="sidebar-footer">
            <a href="/" class="nav-link text-danger">
                <i class="bi bi-box-arrow-left"></i>
                Về trang chủ
            </a>
        </div>

    </nav>

    <div class="main-content" id="content">

        <div class="top-bar">

            <button class="btn btn-outline-secondary d-md-none" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <h4 class="m-0"></h4>

            <div class="user-profile">
                <div class="d-flex align-items-center">

                    <div class="text-end d-none d-sm-block me-3">
                        <small class="d-block text-secondary mb-0" style="font-size:0.75rem;">
                            Xin chào,
                        </small>

                        <span class="fw-bold text-dark">
                            @Context.Session.GetString("Fullname")
                        </span>
                    </div>

                    <div class="user-avatar">
                        <i class="bi bi-person-fill fs-5"></i>
                    </div>

                </div>
            </div>

        </div>

        <div class="container-fluid p-0">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle sidebar mobile
        document.addEventListener("DOMContentLoaded", function () {

        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("sidebar");
        const content = document.getElementById("content");

        toggleBtn?.addEventListener("click", function () {
        sidebar.classList.toggle("active");
        content.classList.toggle("active");
        });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>