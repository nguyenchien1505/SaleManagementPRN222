@model WebBanHang.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="glass-container">
        <div class="glass-card">
            <div class="brand-logo">
                <i class="bi bi-box-seam-fill me-2"></i>SalesM
            </div>

            <div class="auth-header">
                <h2 class="auth-title">Quên mật khẩu?</h2>
                <p class="auth-subtitle">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="form-floating-custom">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="Nhập email của bạn" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth">Gửi link đặt lại mật khẩu</button>

                <div class="auth-footer">
                    <a asp-action="Login">Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}