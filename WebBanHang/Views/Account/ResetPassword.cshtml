@model WebBanHang.ViewModels.ResetPasswordVM
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="glass-container">
        <div class="glass-card">
            <div class="brand-logo">
                <i class="bi bi-box-seam-fill me-2"></i>SalesM
            </div>

            <div class="auth-header">
                <h2 class="auth-title">Đặt lại mật khẩu</h2>
                <p class="auth-subtitle">Nhập mật khẩu mới cho tài khoản của bạn</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <input type="hidden" asp-for="Token" />

                <div class="form-floating-custom">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" placeholder="••••••••" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-floating-custom">
                    <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth">Đặt lại mật khẩu</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}