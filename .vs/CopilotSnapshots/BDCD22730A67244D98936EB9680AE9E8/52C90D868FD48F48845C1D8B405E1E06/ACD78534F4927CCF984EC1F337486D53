@model IEnumerable<WebBanHang.ViewModels.PromotionVM>
@{
    ViewData["Title"] = "Danh Sách Mã Khuyến Mãi";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentSearch = ViewData["CurrentSearch"] as string;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-tags text-primary"></i> Quản Lý Mã Khuyến Mãi (Manager)</h2>
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Tạo Mã Mới</a>
    </div>

    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="searchString" value="@currentSearch" class="form-control" placeholder="Nhập mã cần tìm..." />
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Active" selected="@(currentFilter == "Active" ? "selected" : null)">Đang áp dụng (Active)</option>
                        <option value="Inactive" selected="@(currentFilter == "Inactive" ? "selected" : null)">Tạm dừng (Inactive)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter"></i> Lọc dữ liệu</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary w-100">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th>Mã</th>
                    <th>Loại Giảm Giá</th>
                    <th>Giá Trị</th>
                    <th>Đơn Tối Thiểu</th>
                    <th>Ngày Bắt Đầu</th>
                    <th>Ngày Kết Thúc</th>
                    <th>Trạng Thái</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-primary">@item.Code</td>
                            <td class="text-center">@item.DiscountType</td>
                            <td class="text-end text-success font-weight-bold">
                                @if (item.DiscountType == "Percent")
                                {
                                    <span>@item.Value.ToString("G29")%</span>
                                }
                                else
                                {
                                    <span>@item.Value.ToString("N0") đ</span>
                                }
                            </td>
                            <td class="text-end">@(item.MinOrderValue.HasValue ? item.MinOrderValue.Value.ToString("N0") : "0") đ</td>
                            <td class="text-center">@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy HH:mm") : "---")</td>
                            <td class="text-center">@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd/MM/yyyy HH:mm") : "---")</td>
                            <td class="text-center">
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.PromotionId" class="btn btn-info btn-sm text-white" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.PromotionId" class="btn btn-warning btn-sm text-white" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.PromotionId" class="btn btn-danger btn-sm" title="Xóa"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted p-4">Không tìm thấy mã khuyến mãi nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>